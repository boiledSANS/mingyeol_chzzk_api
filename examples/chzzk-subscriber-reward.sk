# ============================================================================
# 치지직 구독자 보상
# 필요: Skript 2.10.2+ / MingyeolChzzkApi
# 파일 위치: plugins/Skript/scripts/chzzk-subscriber-reward.sk
# 적용: /sk reload chzzk-subscriber-reward
# ============================================================================

options:
    prefix: &8[&2치지직&8] &f
    # 한 번 받을 때 지급할 다이아몬드 수
    reward-diamonds: 3
    # 처음 조회 시 구독/팔로우 목록이 커서 오래 걸릴 수 있습니다.
    # 이 시간 동안 1초마다 API 응답 도착 여부를 확인합니다.
    api-max-wait-seconds: 30
    # 같은 사람이 다시 보상을 받을 수 있는 주기
    reward-cooldown: 24 hours

command /치지직보상:
    cooldown: 10 seconds
    cooldown message: {@prefix}&c치지직 상태 확인은 10초에 한 번만 할 수 있습니다.
    trigger:
        set {_uuid} to uuid of player

        # 계정 연동 전에는 API로 구독 여부를 조회할 수 없습니다.
        if {chzzk_linked::%{_uuid}%} is not true:
            send "{@prefix}&c치지직 계정을 먼저 연동하세요." to player
            send "{@prefix}&e/연동 치지직 &f명령어로 연동할 수 있습니다." to player
            stop

        # 이미 보상을 받았다면 API를 호출하지 않습니다.
        if {chzzk_subscriber_reward_time::%{_uuid}%} is set:
            if difference between now and {chzzk_subscriber_reward_time::%{_uuid}%} is less than {@reward-cooldown}:
                send "{@prefix}&c이미 이번 보상을 받았습니다." to player
                stop

        # API 요청이 진행 중일 때 같은 명령어를 겹쳐 실행하지 못하게 합니다.
        if {chzzk_subscriber_reward_checking::%{_uuid}%} is true:
            send "{@prefix}&e이미 구독 상태를 확인하고 있습니다." to player
            stop
        set {chzzk_subscriber_reward_checking::%{_uuid}%} to true

        # 기존 시간 값을 지워서, 아래 검사에서 이번 API 응답이 도착했는지 확인합니다.
        delete {chzzk_status_updated_at::%{_uuid}%}
        chzzk_refresh_status player
        send "{@prefix}&e치지직 구독 상태를 확인 중입니다..." to player

        # chzzk_refresh_status는 비동기 API 요청입니다. 응답이 올 때까지 최대 30초 대기합니다.
        loop {@api-max-wait-seconds} times:
            wait 1 second
            if {chzzk_status_updated_at::%{_uuid}%} is set:
                set {_apiResponded} to true
                stop loop
        delete {chzzk_subscriber_reward_checking::%{_uuid}%}

        # API 응답이 아직 안 왔거나 조회에 실패한 경우, 이전 캐시로 보상하지 않습니다.
        if {_apiResponded} is not true:
            send "{@prefix}&c구독 상태를 확인하지 못했습니다. 잠시 후 다시 시도하세요." to player
            stop

        # 이번 API 응답으로 갱신된 구독 여부만 사용합니다.
        if chzzk subscriber status of player is not true:
            send "{@prefix}&c현재 방송 채널을 구독 중인 계정만 받을 수 있습니다." to player
            stop

        give {@reward-diamonds} of diamond to player
        set {chzzk_subscriber_reward_time::%{_uuid}%} to now
        send "{@prefix}&a구독자 보상으로 &b다이아몬드 {@reward-diamonds}개&a를 지급했습니다!" to player
